# Environment — copy to .env and fill in only what you need.
# .env is gitignored. NEVER commit real keys.

# Core
APP_ENV=development

# Provider selection: mock | jev | fallback  /  mock | gemini | fallback  /  elevenlabs | browser | disabled
DECISION_PROVIDER=mock
LANGUAGE_PROVIDER=mock
VOICE_PROVIDER=browser

# Jev (decision model) — map these to the real provider once verified in docs/JEV_PROVIDER.md
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=

# Google Gemini (coaching language)
GEMINI_API_KEY=
GEMINI_MODEL=

# ElevenLabs (speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Future persistence (not used yet)
DATABASE_URL=
