# Environment — copy to .env and fill in only what you need.
# .env is gitignored. NEVER commit real keys.

# Core
APP_ENV=development

# Provider selection: mock | jev | fallback  /  mock | gemini | fallback  /  elevenlabs | browser | disabled
DECISION_PROVIDER=mock
LANGUAGE_PROVIDER=mock
VOICE_PROVIDER=browser

# Jev (TypeSafe decision model) — verified, see docs/JEV_PROVIDER.md
JEV_API_KEY=
# Either name works; our config accepts JEV_BASE_URL or the provider's JEV_API_BASE_URL.
JEV_BASE_URL=
JEV_API_BASE_URL=
JEV_MODEL=jev-latest
# Informational docs URL only.
JEV_DOCS=https://docs.typesafe.ai/introduction

# Google Gemini (coaching language)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ElevenLabs (speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Candidate models: eleven_v4_turbo (natural), eleven_flash_v2_5 (fast),
# eleven_turbo_v2_5 (older), eleven_multilingual_v2 (highest quality, slower).
ELEVENLABS_MODEL_ID=eleven_v4_turbo
# Never use telephony formats (ulaw_8000/alaw_8000); use 44.1 kHz MP3.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STABILITY=0.55
ELEVENLABS_SIMILARITY_BOOST=0.80
ELEVENLABS_STYLE=0.15
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_SPEED=1.0

# Live IMU sensor over BLE (requires bleak + the powered wearable).
# Keep false for the offline demo and tests.
SENSOR_ENABLED=false
SENSOR_DEVICE_NAME=MotionCoach-IMU
SENSOR_BUFFER_SECONDS=6
SENSOR_RETRY_DELAY=2
# Save each finalized live set to data/debug/ (gitignored) for offline diagnosis.
DEBUG_SAVE_LIVE_SETS=false

# Live-demo provider latency budgets (seconds). Over budget -> deterministic fallback.
LIVE_JEV_TIMEOUT_S=2.0
LIVE_GEMINI_TIMEOUT_S=2.0

# Future persistence (not used yet)
DATABASE_URL=
