# Environment — copy to .env and fill in only what you need.
# .env is gitignored. NEVER commit real keys.

# Core
APP_ENV=development

# Provider selection: mock | jev | fallback  /  mock | gemini | fallback  /  elevenlabs | browser | disabled
DECISION_PROVIDER=mock
LANGUAGE_PROVIDER=mock
VOICE_PROVIDER=browser

# Jev (TypeSafe decision model) — verified, see docs/JEV_PROVIDER.md
JEV_API_KEY=
# Either name works; our config accepts JEV_BASE_URL or the provider's JEV_API_BASE_URL.
JEV_BASE_URL=
JEV_API_BASE_URL=
JEV_MODEL=jev-latest
# Informational docs URL only.
JEV_DOCS=https://docs.typesafe.ai/introduction

# Google Gemini (coaching language)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ElevenLabs (speech)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Future persistence (not used yet)
DATABASE_URL=
